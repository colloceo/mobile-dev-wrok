<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    style="@style/Widget.BillReminder.ListCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <View
                android:id="@+id/categoryIconBg"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle" />

            <ImageView
                android:id="@+id/categoryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_bolt" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textBillName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                tools:text="Netflix" />

            <TextView
                android:id="@+id/textDueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Due in 3 days" />
        </LinearLayout>

        <TextView
            android:id="@+id/textAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            tools:text="KES 1,100.00" />

        <ImageButton
            android:id="@+id/btnMarkPaid"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_accent_circle"
            android:contentDescription="@string/mark_paid_cd"
            android:padding="7dp"
            android:src="@drawable/ic_check"
            android:tint="@color/accent" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
